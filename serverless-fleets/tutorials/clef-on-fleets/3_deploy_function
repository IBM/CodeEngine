#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

# Self-contained helper functions
print_msg() { echo -e "\033[94m$1\033[0m"; }
print_success() { echo -e "\033[32m$1\033[0m"; }
print_error() { echo -e "\033[31m$1\033[0m"; }
print_cmd() { echo -e "  $1"; }

# ==============================
# CONFIGURATION
# ==============================
FN_NAME="${FN_NAME:=clef-classify-fn}"
FLEET_ID="${1:-${FLEET_ID:-}}"
TRUSTED_PROFILE_NAME="${TRUSTED_PROFILE_NAME:=clef-fn-access}"
COS_PREFIX="${COS_PREFIX:=clef-result}"
FILE_PREFIX="${FILE_PREFIX:=result}"
PDS_NAME="${PDS_NAME:=fleet-output-store}"
COS_BUCKET="${COS_BUCKET:=}"
COS_ENDPOINT="${COS_ENDPOINT:=}"

# Auto-discover the real COS bucket name and region from persistent data store (PDS)
if [[ -z "${COS_BUCKET}" ]]; then
  PDS_JSON=$(ibmcloud ce pds get --name "${PDS_NAME}" --output json 2>/dev/null || echo "")
  if [[ -n "${PDS_JSON}" ]]; then
    COS_BUCKET=$(echo "${PDS_JSON}" | jq -r '.data.bucket_name // .cos_bucket_name // .cos_bucket // empty')
    PDS_REGION=$(echo "${PDS_JSON}" | jq -r '.data.bucket_location // .bucket_region // .region // empty')
    if [[ -n "${PDS_REGION}" && -z "${COS_ENDPOINT}" ]]; then
      COS_ENDPOINT="https://s3.direct.${PDS_REGION}.cloud-object-storage.appdomain.cloud"
    fi
  fi
fi

COS_BUCKET="${COS_BUCKET:=fleet-output-store}"
COS_ENDPOINT="${COS_ENDPOINT:=https://s3.direct.eu-de.cloud-object-storage.appdomain.cloud}"
POLL_TIMEOUT="${POLL_TIMEOUT:=45}"
MAX_EXECUTION_TIME="${MAX_EXECUTION_TIME:=120}"
FUNCTION_DIR="${SCRIPT_DIR}/function"

# If FLEET_ID is not provided in env, attempt to auto-discover the latest clef fleet
if [[ -z "${FLEET_ID}" ]]; then
  print_msg "FLEET_ID not set. Looking up latest clef fleet in the project..."
  FLEET_ID=$(ibmcloud ce fleet list --output json 2>/dev/null | jq -r '([.[] | select(.name | test("clef"))] | sort_by(.created_at) | last | .id // empty) // empty' || echo "")
fi

if [[ -z "${FLEET_ID}" ]]; then
  print_error "FLEET_ID is required. Pass it as \$1 (./3_deploy_function <fleet-id>) or set export FLEET_ID=<fleet-id>."
  exit 1
fi

# ==============================
# TRUSTED PROFILE (replaces the former CE_API_KEY secret)
# The function exchanges its Code Engine compute resource token for an IAM
# token of this profile. The profile is linked to the function by name and is
# granted: Writer on the Code Engine project (add fleet tasks) and
# Object Reader on the results bucket (poll results).
# ==============================
# 'project current' does not return the CRN, 'project get' does.
CE_PROJECT_NAME=$(ibmcloud ce project current --output json | jq -r '.name')
CE_PROJECT_JSON=$(ibmcloud ce project get --name "${CE_PROJECT_NAME}" --output json)
CE_PROJECT_CRN=$(echo "${CE_PROJECT_JSON}" | jq -r '.crn // empty')
CE_PROJECT_GUID=$(echo "${CE_PROJECT_JSON}" | jq -r '.guid // empty')
if [[ -z "${CE_PROJECT_CRN}" || -z "${CE_PROJECT_GUID}" ]]; then
  print_error "Could not determine CRN/GUID of Code Engine project '${CE_PROJECT_NAME}'."
  exit 1
fi

# COS instance hosting the results bucket: explicit CRN, explicit name, or the
# only COS instance in the targeted resource group.
if [[ -z "${COS_INSTANCE_ID:-}" ]]; then
  if [[ -n "${COS_INSTANCE_NAME:-}" ]]; then
    COS_INSTANCE_ID=$(ibmcloud resource service-instance "${COS_INSTANCE_NAME}" --output json 2>/dev/null | jq -r '.[0].id // empty' || echo "")
  else
    COS_INSTANCES=$(ibmcloud resource service-instances --service-name cloud-object-storage --output json 2>/dev/null || echo "[]")
    if [[ "$(echo "${COS_INSTANCES}" | jq 'length')" == "1" ]]; then
      COS_INSTANCE_ID=$(echo "${COS_INSTANCES}" | jq -r '.[0].id')
    fi
  fi
fi
if [[ -z "${COS_INSTANCE_ID:-}" ]]; then
  print_error "Could not determine the COS instance of bucket '${COS_BUCKET}'."
  echo "Set export COS_INSTANCE_NAME=<name> or COS_INSTANCE_ID=<crn>."
  exit 1
fi

print_msg "Ensuring trusted profile '${TRUSTED_PROFILE_NAME}'..."
if ! ibmcloud iam trusted-profile "${TRUSTED_PROFILE_NAME}" >/dev/null 2>&1; then
  ibmcloud iam trusted-profile-create "${TRUSTED_PROFILE_NAME}"
fi

if ! ibmcloud iam trusted-profile-links "${TRUSTED_PROFILE_NAME}" --output json 2>/dev/null \
    | jq -e --arg n "ce-fn-${FN_NAME}" '.[] | select(.name == $n)' >/dev/null 2>&1; then
  ibmcloud iam trusted-profile-link-create "${TRUSTED_PROFILE_NAME}" \
    --name "ce-fn-${FN_NAME}" \
    --cr-type CE \
    --link-crn "${CE_PROJECT_CRN}" \
    --link-component-type function \
    --link-component-name "${FN_NAME}"
fi

PROFILE_POLICIES=$(ibmcloud iam trusted-profile-policies "${TRUSTED_PROFILE_NAME}" --output json 2>/dev/null || echo "[]")
if ! echo "${PROFILE_POLICIES}" | jq -e --arg s "${CE_PROJECT_GUID}" '.[] | select(.resources[]?.attributes[]? | .value == $s)' >/dev/null 2>&1; then
  ibmcloud iam trusted-profile-policy-create "${TRUSTED_PROFILE_NAME}" \
    --roles "Writer" \
    --service-name codeengine \
    --service-instance "${CE_PROJECT_GUID}"
fi
if ! echo "${PROFILE_POLICIES}" | jq -e --arg b "${COS_BUCKET}" '.[] | select(.resources[]?.attributes[]? | .value == $b)' >/dev/null 2>&1; then
  ibmcloud iam trusted-profile-policy-create "${TRUSTED_PROFILE_NAME}" \
    --roles "Object Reader" \
    --service-name cloud-object-storage \
    --service-instance "${COS_INSTANCE_ID}" \
    --resource-type bucket \
    --resource "${COS_BUCKET}"
fi

print_msg "\nDeploying Code Engine function '${FN_NAME}' from ${FUNCTION_DIR} ..."
echo ""
echo "ibmcloud ce fn create"
echo "    --name            ${FN_NAME}"
echo "    --build-source    ${FUNCTION_DIR}"
echo "    --runtime         python-3.11"
echo "    --maxexecutiontime ${MAX_EXECUTION_TIME}"
echo "    --env             FLEET_ID=${FLEET_ID}"
echo "    --env             COS_BUCKET=${COS_BUCKET}"
echo "    --env             COS_PREFIX=${COS_PREFIX}"
echo "    --env             FILE_PREFIX=${FILE_PREFIX}"
echo "    --env             COS_ENDPOINT=${COS_ENDPOINT}"
echo "    --env             POLL_TIMEOUT=${POLL_TIMEOUT}"
echo "    --env             TRUSTED_PROFILE_NAME=${TRUSTED_PROFILE_NAME}"
echo "    --trusted-profiles-enabled=true"
echo ""

if ibmcloud ce fn get --name "${FN_NAME}" >/dev/null 2>&1; then
  print_msg "Function '${FN_NAME}' already exists. Updating..."
  ibmcloud ce fn update \
    --name "${FN_NAME}" \
    --build-source "${FUNCTION_DIR}" \
    --runtime python-3.13 \
    --maxexecutiontime "${MAX_EXECUTION_TIME}" \
    --env FLEET_ID="${FLEET_ID}" \
    --env COS_BUCKET="${COS_BUCKET}" \
    --env COS_PREFIX="${COS_PREFIX}" \
    --env FILE_PREFIX="${FILE_PREFIX}" \
    --env COS_ENDPOINT="${COS_ENDPOINT}" \
    --env POLL_TIMEOUT="${POLL_TIMEOUT}" \
    --env TRUSTED_PROFILE_NAME="${TRUSTED_PROFILE_NAME}" \
    --trusted-profiles-enabled=true
else
  ibmcloud ce fn create \
    --name "${FN_NAME}" \
    --build-source "${FUNCTION_DIR}" \
    --runtime python-3.13 \
    --maxexecutiontime "${MAX_EXECUTION_TIME}" \
    --env FLEET_ID="${FLEET_ID}" \
    --env COS_BUCKET="${COS_BUCKET}" \
    --env COS_PREFIX="${COS_PREFIX}" \
    --env FILE_PREFIX="${FILE_PREFIX}" \
    --env COS_ENDPOINT="${COS_ENDPOINT}" \
    --env POLL_TIMEOUT="${POLL_TIMEOUT}" \
    --env TRUSTED_PROFILE_NAME="${TRUSTED_PROFILE_NAME}" \
    --trusted-profiles-enabled=true
fi

FN_ENDPOINT=$(ibmcloud ce fn get --name "${FN_NAME}" --output json | jq -r '.endpoint // empty' 2>/dev/null || echo "")

print_success "\n=========================================="
print_success " Function deployed successfully"
print_success "==========================================\n"
print_msg "Function Name: ${FN_NAME}"
if [[ -n "${FN_ENDPOINT}" ]]; then
  print_msg "Endpoint:      ${FN_ENDPOINT}"
  print_msg "\nTest classification via the function:"
  print_cmd "  ./4_test_classify_fn"
  print_msg "\nOr test direct fleet task submission:"
  print_cmd "  ./5_test_fleet_task_add"
fi
