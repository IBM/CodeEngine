# ============================================================
# setup.env — Configuration template for setup.sh
#
# Copy this file to setup.env.local, fill in your values,
# and run setup.sh (it loads setup.env.local automatically):
#
#   cp setup.env setup.env.local
#   # edit setup.env.local with real values
#   ./setup.sh
#
# DO NOT commit a copy of this file that contains real secrets.
#
# All cloud resource names (resource group, Object Storage, Code Engine
# project, application, secrets, data store) are derived by setup.sh from
# NAME_PREFIX plus a random 4-character suffix (new on every run), e.g.
#   ce-qiskit-jupyterlab-3fa9
# To reuse an existing set, export NAME_SUFFIX=<suffix> before running setup.sh.
# To override one of them, export it in your shell before running setup.sh,
# for example:  CE_PROJECT_NAME=my-project ./setup.sh
# ============================================================

# ------------------------------------------------------------
# IBM Cloud
# ------------------------------------------------------------

# IBM Cloud API key (optional) — create one at:
# https://cloud.ibm.com/iam/apikeys
# If it is not set, setup.sh logs in interactively with
# 'ibmcloud login --sso' and asks you for a one-time passcode.
#IBMCLOUD_API_KEY="<your-ibm-cloud-api-key>"

# IBM Cloud region where all resources will be created, e.g. us-south, eu-de.
# A value exported in your shell takes precedence.
IBMCLOUD_REGION="${IBMCLOUD_REGION:-eu-de}"

# Prefix for all resource names: lowercase letters, digits and dashes,
# starting with a letter, at most 40 characters.
# A value exported in your shell takes precedence.
NAME_PREFIX="${NAME_PREFIX:-ce-qiskit-jupyterlab}"

# ------------------------------------------------------------
# IBM Quantum (Qiskit Runtime Service credentials)
# ------------------------------------------------------------

# Your IBM Quantum API token — copy it from:
# https://quantum.cloud.ibm.com/ → Dashboard → API key
QISKIT_IBM_TOKEN="<your-ibm-quantum-api-token>"

# CRN of the IBM Quantum instance you want to use.
# Find it at: https://quantum.cloud.ibm.com/instances → hover over the CRN and copy.
QISKIT_IBM_INSTANCE="<your-ibm-quantum-instance-crn>"

# ------------------------------------------------------------
# JupyterLab
# ------------------------------------------------------------

# Access token that protects the JupyterLab UI.
# Set this to a long, random string — e.g. output of:  openssl rand -hex 32
JUPYTER_TOKEN="<your-jupyterlab-access-token>"
