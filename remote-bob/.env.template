# Remote Bob — Configuration Template
# Copy this file to .env in this directory and fill in your values.
#
# Usage:
#   cp .env.template .env
#   # edit .env with your credentials
#   ./run.sh --mode=local --config=.env
#   ./run.sh --mode=codeengine --config=.env
#
# ─── Required (both modes) ──────────────────────────────────────────────────

# Bob Shell API key — get from https://bob.ibm.com (Settings → API Keys,
# scope: Inference)
BOBSHELL_API_KEY=your-bob-shell-api-key-here

# Basic-auth password for the gateway login prompt
GATEWAY_PASSWORD=your-gateway-password-here

# ─── Auto-generated (run.sh writes these on first run) ──────────────────────
# Leave blank — run.sh generates and persists them for you.

# 32-char hex gateway token (16 random bytes)
# GATEWAY_TOKEN=

# AES-256 key used to sign run tokens, base64-encoded (44 chars)
# ENCRYPTION_KEY=

# ─── Code Engine mode — required ────────────────────────────────────────────

# IBM Cloud API key with Code Engine permissions
# IBMCLOUD_API_KEY=your-ibmcloud-api-key-here

# Code Engine region (default: us-east)
# CE_REGION=us-east

# Code Engine project name (created if it does not exist)
# CE_PROJECT=remote-bob-fleet-sandbox--ce-project

# IBM Cloud resource group (created if it does not exist)
# RESOURCE_GROUP=remote-bob-fleet-sandbox--rg

# ─── Local mode — optional ───────────────────────────────────────────────────

# Host port the API server binds to (default: 3000)
# API_PORT=3000

# Maximum seconds to wait for the job-agent to become ready (default: 240)
# AGENT_READY_TIMEOUT=240

# ─── Job-agent — optional ───────────────────────────────────────────────────

# Bob mode: interactive, plan, or auto (default: interactive)
# BOB_MODE=interactive

# Idle timeout in milliseconds before the agent shuts down (default: 300000 = 5 min)
# IDLE_TIMEOUT_MS=300000

# ttyd WebSocket port inside the job-agent container (default: 7080)
# TTYD_PORT=7080

# Health check port inside the job-agent container (default: 7081)
# HEALTH_PORT=7081

# ─── Git integration — optional ─────────────────────────────────────────────

# GitHub Personal Access Token (enables repo clone + session branch push)
# GH_PAT=

# GitHub repo to clone into /workspace (e.g. https://github.com/org/repo)
# GH_REPO=

# Branch to clone and base the session branch from (default: main)
# GH_BRANCH=main

# ─── Code Engine mode — optional ────────────────────────────────────────────

# Code Engine app name for the API server (default: remote-bob-apiserver)
# APISERVER_APP_NAME=remote-bob-apiserver

# Code Engine job name for the job-agent (default: remote-bob-job-agent)
# JOB_NAME=remote-bob-job-agent

# Configmap name shared by all CE services (default: remote-bob-config)
# CE_CONFIGMAP_NAME=remote-bob-config

# Job-agent run CPU (default: 1)
# DEFAULT_CPU=1

# Job-agent run memory (default: 2G)
# DEFAULT_MEMORY=2G

# Job-agent run max execution time in seconds (default: 86400, max: 86400)
# DEFAULT_TIMEOUT=86400

# Set to "stop" to scale the API server to zero instead of deleting it on close
# CE_CLEANUP_APP=delete

# ─── Advanced — optional ────────────────────────────────────────────────────

# Chrome remote-debugging port (for E2E / CDP tooling)
# CHROME_DEBUG_PORT=

# Log level for the API server and job-agent (debug, info, warn, error)
# LOG_LEVEL=info

# BOB_APPROVAL_MODE overrides the approvalMode field in Bob Shell settings
# (auto_approve, manual, etc.)
# BOB_APPROVAL_MODE=

# Set to "true" or "false" to override Bob Shell telemetry
# BOB_TELEMETRY_ENABLED=

# ─── Session state — managed by run.sh, do not edit manually ────────────────
# These are written and read back by run.sh to support reconnect and
# --end-session. You can delete them to force a fresh session.

# AGENT_ID=
# SESSION_MODE=
# API_SERVER_URL=
# CE_JOB_RUN_NAME=
# EXISTING_APISERVER_CONTAINER=
# EXISTING_JOB_AGENT_CONTAINER=
# EXISTING_LOCAL_NETWORK=
# LAST_APISERVER_COMMIT=
# LAST_JOB_AGENT_COMMIT=
