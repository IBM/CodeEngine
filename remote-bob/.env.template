# Remote Bob — Configuration Template
# Copy this file to .env and fill in the required keys for your chosen agent.
#
# Workflow:
#   cp .env.template .env
#   # edit .env — set the required keys for your chosen agent preset
#   ./remote-bob --setup                                     # default: IBM Bob Shell
#   ./remote-bob --setup --agent-preset=job-agent/agents/claude  # Claude Code
#   ./remote-bob --new-session    # start a job run and open the browser
#   ./remote-bob --connect        # reopen the browser (session still running)
#   ./remote-bob --end-session    # kill the job run (infra stays)
#   ./remote-bob --clean          # remove all IBM Cloud resources
#   ./remote-bob                  # show current status

# ─── Infrastructure (required for all presets) ────────────────────────────────

# Basic-auth password shown in the browser login prompt
GATEWAY_PASSWORD=your-gateway-password-here

# IBM Cloud API key with Code Engine and Container Registry permissions
IBMCLOUD_API_KEY=your-ibmcloud-api-key-here

# ─── IBM Bob Shell (default preset: job-agent/agents/bob) ────────────────────
# Required when using the default bob preset.
# Get from https://bob.ibm.com (Settings → API Keys)
BOBSHELL_API_KEY=your-bob-shell-api-key-here

# ─── Claude Code (preset: job-agent/agents/claude) ───────────────────────────
# Required when using --agent-preset=job-agent/agents/claude
# Get from https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── OpenAI Codex CLI (preset: job-agent/agents/openai) ──────────────────────
# Required when using --agent-preset=job-agent/agents/openai
# Get from https://platform.openai.com → API Keys
# OPENAI_API_KEY=your-openai-api-key-here

# ─── Gemini CLI (preset: job-agent/agents/gemini) ────────────────────────────
# Required when using --agent-preset=job-agent/agents/gemini
# Get from https://aistudio.google.com → Get API Key
# GEMINI_API_KEY=your-gemini-api-key-here

# ─── OpenCode (preset: job-agent/agents/opencode) ────────────────────────────
# Required when using --agent-preset=job-agent/agents/opencode
# OpenCode supports multiple providers — set the key for the provider you use.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ─── Agent preset (optional) ─────────────────────────────────────────────────
# Path to the agent preset directory used by --setup.
# Can be set here instead of passing --agent-preset=PATH on the command line.
# Relative paths are resolved from the remote-bob/ directory.
# Defaults to job-agent/agents/bob when not set.
# AGENT_PRESET=job-agent/agents/bob

# ─── Optional overrides (defaults shown) ─────────────────────────────────────

# IBM Cloud region
# CE_REGION=us-east

# Code Engine project (created if it does not exist)
# CE_PROJECT=remote-bob--ce-project

# IBM Cloud resource group (created if it does not exist)
# RESOURCE_GROUP=remote-bob--rg

# CE app name for the apiserver
# APISERVER_APP_NAME=remote-bob-apiserver

# CE job name for the job-agent (defaults to remote-bob-job-agent-<preset-name>)
# JOB_NAME=remote-bob-job-agent-bob

# Job-agent run resources
# DEFAULT_CPU=1
# DEFAULT_MEMORY=2G
# DEFAULT_TIMEOUT=86400

# ─── Persistent Workspace (IBM Cloud Object Storage + Code Engine PDS) ───────
# When enabled, an IBM Cloud Object Storage instance and bucket are provisioned
# and mounted to /workspace in the job container via a Code Engine Persistent
# Data Store (PDS). Files written to /workspace persist across sessions.
# Can also be activated via ./remote-bob --setup --persistent-workspace
# PERSISTENT_WORKSPACE=false
# COS_INSTANCE_NAME=remote-bob-cos
# COS_BUCKET_NAME=                  # defaults to remote-workspace-<random_hex>
# COS_SERVICE_KEY_NAME=remote-bob-cos-key
# CE_PDS_SECRET_NAME=remote-bob-cos-secret
# CE_PDS_NAME=remote-bob-workspace-store

# Path to Chrome binary (auto-detected on macOS and Linux if not set)
# CHROME_BIN=

# Chrome remote-debugging port (CDP / E2E tooling)
# CHROME_DEBUG_PORT=

# HMAC signing key for run tokens — generated fresh in-memory each run.
# Set only if you need token stability across apiserver restarts.
# ENCRYPTION_KEY=
