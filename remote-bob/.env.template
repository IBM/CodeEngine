# Remote Bob — Configuration Template
# Copy this file to .env and fill in your values.
#
# Usage:
#   cp .env.template .env
#   # edit .env — set the three required keys below
#   ./run.sh                  # start or reconnect
#   ./run.sh --end-session    # tear down the running session
#   ./run.sh --clean          # remove all IBM Cloud resources

# ─── Required ────────────────────────────────────────────────────────────────

# Bob Shell API key — get from https://bob.ibm.com (Settings → API Keys)
BOBSHELL_API_KEY=your-bob-shell-api-key-here

# Basic-auth password shown in the browser login prompt
GATEWAY_PASSWORD=your-gateway-password-here

# IBM Cloud API key with Code Engine and Container Registry permissions
IBMCLOUD_API_KEY=your-ibmcloud-api-key-here

# ─── Auto-generated on first run (leave blank) ───────────────────────────────

# HMAC key (base64, 44 chars) used to sign run tokens — generated if absent
# ENCRYPTION_KEY=

# ─── Code Engine — optional (defaults shown) ─────────────────────────────────

# IBM Cloud region
# CE_REGION=us-east

# Code Engine project (created if it does not exist)
# CE_PROJECT=remote-bob--ce-project

# IBM Cloud resource group (created if it does not exist)
# RESOURCE_GROUP=remote-bob--rg

# CE app name for the apiserver
# APISERVER_APP_NAME=remote-bob-apiserver

# CE job name for the job-agent
# JOB_NAME=remote-bob-job-agent

# Job-agent run resources
# DEFAULT_CPU=1
# DEFAULT_MEMORY=2G
# DEFAULT_TIMEOUT=86400

# What to do with the apiserver app on --end-session: delete (default) or stop
# CE_CLEANUP_APP=delete

# ─── Job-agent — optional ────────────────────────────────────────────────────

# Bob mode: interactive (default), plan, or auto
# BOB_MODE=interactive

# Idle timeout before the agent shuts down (milliseconds)
# IDLE_TIMEOUT_MS=300000

# Override the Bob Shell approvalMode at runtime
# BOB_APPROVAL_MODE=

# Override Bob Shell telemetry
# BOB_TELEMETRY_ENABLED=

# ─── Advanced — optional ─────────────────────────────────────────────────────

# Path to Chrome binary (auto-detected on macOS and Linux if not set)
# CHROME_BIN=

# Chrome remote-debugging port (CDP / E2E tooling)
# CHROME_DEBUG_PORT=

# ─── Session state — written by run.sh, do not edit manually ─────────────────

# AGENT_ID=
# API_SERVER_URL=
# CE_JOB_RUN_NAME=
