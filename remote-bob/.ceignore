# CE source-upload ignore rules for the job-agent build — generated by ./remote-bob --setup.
# Do not edit manually; this file is rewritten before each build.

# Secrets and local config
.env
.env.template

# Apiserver source (not needed for job-agent build)
apiserver/

# Static browser client (not needed in the job-agent container)
browser-client/

# Launcher script and docs
remote-bob
README.md
.gitignore

# Runtime scratch and caches
tmp/
bobshell-*.tgz
*.log
.DS_Store

# Agent preset directories — all excluded except the selected preset.
# The selected preset is included so the Dockerfile can COPY and run it.
job-agent/agents/bob/
job-agent/agents/claude/
job-agent/agents/gemini/
job-agent/agents/openai/
job-agent/agents/opencode/
