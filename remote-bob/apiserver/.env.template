# Remote Bob API Server — Environment Variables
# Reference for the variables the apiserver reads. In the v4 flow, run.sh
# starts the apiserver container (local mode) or deploys it to Code Engine
# (codeengine mode) — you do not set these by hand.

# ============================================
# Local mode (LOCAL_MODE=true)
# ============================================

# HTTP listen port (default: 8080; run.sh publishes host API_PORT → 8080)
PORT=8080

# Gateway token (required in local mode; fails startup if missing)
GATEWAY_TOKEN=changeme

# Gateway basic-auth password (fails closed: empty/unset → login returns 503)
GATEWAY_PASSWORD=changeme

# Base64 of 32 bytes (AES-256); also the HMAC signing key for run tokens
ENCRYPTION_KEY=

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Comma-separated CORS allowed origins (default: localhost + "null")
# ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Code Engine mode (secrets mounted under /secrets/)
# ============================================

# /secrets/gateway/gateway-token      — gateway token
# /secrets/gateway/gateway-password   — basic-auth password
# /secrets/gateway/encryption-key     — base64 32-byte key
# /secrets/ibmcloud/api-key           — IBM Cloud API key

# Configmap values (non-sensitive):
# CE_PROJECT_ID, CE_REGION, CE_JOB_NAME, LOG_LEVEL, LOCAL_MODE=false

# ============================================
# Notes
# ============================================

# 1. Never commit this file with real credentials
# 2. The v3-era LOCAL_SESSION_ID / LOCAL_SESSION_TOKEN / SESSION_ID /
#    SESSION_TOKEN / GATEWAY_CALLBACK_URL variables are removed in v4 —
#    use AGENT_ID + RUN_TOKEN instead
LAST_APISERVER_COMMIT=3d9257c8963e2706b9bef6f4c4be05be20524145
LAST_JOB_AGENT_COMMIT=3d9257c8963e2706b9bef6f4c4be05be20524145
AGENT_ID=agent-99380cea3ab25785
SESSION_MODE=local
EXISTING_APISERVER_CONTAINER=remote-bob-apiserver-719434
EXISTING_LOCAL_NETWORK=remote-bob-local-719434
EXISTING_JOB_AGENT_CONTAINER=remote-bob-job-agent-719434
