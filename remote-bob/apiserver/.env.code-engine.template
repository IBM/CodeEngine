# Remote Bob API Server — Code Engine Environment Variables
# Reference for the variables the apiserver reads in Code Engine mode. In
# the v4 flow, run.sh --mode=codeengine provisions the CE secrets/configmap
# and deploys the app — you do not set these by hand.

# ============================================
# Secrets (mounted under /secrets/)
# ============================================

# /secrets/gateway/gateway-token      — gateway token
# /secrets/gateway/gateway-password   — basic-auth password
# /secrets/gateway/encryption-key     — base64 32-byte key (run-token signing)
# /secrets/ibmcloud/api-key           — IBM Cloud API key

# ============================================
# Configmap (non-sensitive)
# ============================================

# CE_PROJECT_ID   — Code Engine project ID
# CE_REGION       — Code Engine region
# CE_JOB_NAME     — job-agent job definition name
# LOG_LEVEL       — log level (debug, info, warn, error)
# LOCAL_MODE      — must be "false" in Code Engine mode

# ============================================
# Optional
# ============================================

# HTTP port (default: 8080)
# PORT=8080

# Comma-separated CORS allowed origins (default: localhost + "null")
# ALLOWED_ORIGINS=

# ============================================
# Notes
# ============================================

# 1. Never commit this file with real credentials
# 2. Use Code Engine secrets for sensitive values in production
# 3. The v3-era LOCAL_SESSION_ID / LOCAL_SESSION_TOKEN / SESSION_ID /
#    SESSION_TOKEN / GATEWAY_CALLBACK_URL variables are removed in v4 —
#    use AGENT_ID + RUN_TOKEN instead
