# Remote Bob Job Agent — Code Engine Environment Variables
# Reference for the variables the job-agent daemon reads. In the v4 flow,
# run.sh --mode=codeengine provisions the CE secrets/configmap, deploys the
# apiserver app, and submits the job run with AGENT_ID + RUN_TOKEN — you do
# not set these by hand.

# ============================================
# Required Configuration
# ============================================

# Bob Shell API Key (for authentication)
# Get from: https://bob.ibm.com (Settings → API Keys)
# Scope: Inference
BOBSHELL_API_KEY=your-bob-shell-api-key-here

# Gateway WebSocket URL (wss://)
# Example: wss://remote-bob-gateway.xxx.codeengine.appdomain.cloud/ws
GATEWAY_WSS=wss://your-gateway-url/ws

# ============================================
# Session Configuration (Provided by run.sh)
# ============================================

# These are provided by run.sh at job-run submit time.
# Do NOT set them in the job definition — they are passed at runtime.

# AGENT_ID=<provided-by-run.sh>
# RUN_TOKEN=<provided-by-run.sh>

# ============================================
# Optional Configuration
# ============================================

# ttyd port (default: 7080, loopback only)
# TTYD_PORT=7080

# Health check port (default: 7081, loopback only)
# HEALTH_PORT=7081

# Bob mode: interactive, plan, or auto (default: interactive)
# BOB_MODE=interactive

# Idle timeout in ms (default: 300000 = 5 min)
# IDLE_TIMEOUT_MS=300000

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# Notes
# ============================================

# 1. Never commit this file with real credentials
# 2. Use Code Engine secrets for sensitive values in production
# 3. The v3-era SESSION_ID / SESSION_TOKEN / GATEWAY_CALLBACK_URL variables
#    are removed in v4 — use AGENT_ID + RUN_TOKEN instead
# 4. Get Bob Shell API key from https://bob.ibm.com
# 5. Ensure API key has "Inference" scope enabled
